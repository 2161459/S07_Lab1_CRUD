@model ZombieParty.Models.Zombie

@{
    ViewData["Title"] = "Delete Zombie";
}

<h1>Delete Zombie</h1>

<h3>Are you sure you want to delete this zombie?</h3>

<div>
    <h4>@Model.Name</h4>

    <p>Points: @Model.Point</p>

    <form asp-action="DeletePost" method="post">

        <input type="hidden" name="id" value="@Model.Id" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>
